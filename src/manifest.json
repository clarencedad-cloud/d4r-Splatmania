{
    "name": "Splatmania",
    "short_name": "Splatmania",
    "description": "Splatmania – Gaussian-Splat-Editor von design4real: säubern, ausrichten, animieren und als Film ausgeben.",
    "display": "fullscreen",
    "start_url": "./",
    "scope": "./",
    "background_color": "#000000",
    "theme_color": "#000000",
    "icons": [
        {
            "src": "./static/icons/logo-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "./static/icons/logo-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "file_handlers": [
        {
            "action": "./",
            "accept": {
                "application/ply": [".ply"],
                "application/octet-stream": [".splat", ".sog", ".spz", ".ksplat", ".ssproj"]
            }
        }
    ]
}