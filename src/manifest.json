{
    "id": "./",
    "name": "Splatmania",
    "short_name": "Splatmania",
    "description": "Splatmania – free Gaussian splat editor by design4real: clean up, align, animate and render your splats to video and 360° panoramas.",
    "display": "standalone",
    "start_url": "./",
    "scope": "./",
    "background_color": "#15121e",
    "theme_color": "#15121e",
    "icons": [
        {
            "src": "./static/icons/logo-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "./static/icons/logo-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "file_handlers": [
        {
            "action": "./",
            "accept": {
                "application/ply": [
                    ".ply"
                ],
                "application/octet-stream": [
                    ".splat",
                    ".sog",
                    ".spz",
                    ".ksplat",
                    ".ssproj"
                ]
            }
        }
    ]
}
